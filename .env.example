# 复制本文件为 .env,并把 DEEPSEEK_API_KEY 换成真实 key
# 申请地址:https://platform.deepseek.com/api_keys(注册送额度,本项目够用)
#
# 不填也能跑,但后果是:
#   analyzers/llm_analyzer.py 直接退出 -> 不生成 data/clean/analysis.json
#   -> reports/report_builder.py 降级为「仅预筛」报告(只有关键词过滤,没有语义相关度)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
